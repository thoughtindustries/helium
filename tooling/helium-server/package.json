{
  "name": "@thoughtindustries/helium-server",
  "version": "3.0.0-beta.19",
  "description": "Packages needed for running Helium Server",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./*": "./src/utilities/*.ts"
  },
  "scripts": {
    "build:graphiql": "vite build -c vite.graphiql.config.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external vike && npm run build:graphiql",
    "watch": "npm run build -- --watch src",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "worker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoughtindustries/helium.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thoughtindustries/helium/issues"
  },
  "homepage": "https://github.com/thoughtindustries/helium#readme",
  "dependencies": {
    "@apollo/client": "^3.7.0",
    "@graphiql/toolkit": "^0.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cookie-parser": "^1.4.7",
    "crypto-hash": "^2.0.1",
    "dotenv": "^16.0.3",
    "express": "^4.21.2",
    "graphiql": "^2.2.0",
    "graphql": "^16.11.0",
    "isomorphic-unfetch": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vike": "0.4.195",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.14",
    "tsup": "^8.5.0"
  },
  "volta": {
    "node": "18.20.7",
    "npm": "10.8.2"
  },
  "engines": {
    "node": ">=16.18.1",
    "npm": ">=8.19.2"
  },
  "gitHead": "8974c20a302c8cc403568cc88ec180ee74c2eb80"
}
